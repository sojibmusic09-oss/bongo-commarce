# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build outputs
/.next/
/out/
/build
/dist

# Environment & Secrets (NEVER commit real secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Runtime storage, encrypted DB config, backups & uploads
/storage/backups/*
!/storage/backups/.gitkeep
/storage/config/*
!/storage/config/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep

# Logs & OS files
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.DS_Store
*.tsbuildinfo
next-env.d.ts

# Packaged archives
*.zip
