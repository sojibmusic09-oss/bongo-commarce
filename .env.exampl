# ============================================================
# PLATFORM CORE CONFIGURATION
# Copy this file to .env and fill real values. NEVER commit .env
# ============================================================
NODE_ENV=development
APP_NAME=BongoCommerce SaaS
APP_URL=http://localhost:3000
PLATFORM_ROOT_DOMAIN=localhost:3000
PORT=3000

# 64-char hex key (32 bytes) generated via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=replace_with_64_hex_chars_32_bytes_secret_key_for_aes_256_gcm_00
SESSION_SECRET=replace_with_at_least_32_chars_random_hmac_session_secret_key

# ============================================================
# INITIAL BOOTSTRAP DATABASE (postgresql | mysql | mariadb)
# ============================================================
DB_ENGINE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bongo_saas
DB_USER=postgres
DB_PASSWORD=replace_with_strong_db_password
DB_SSL=false

# ============================================================
# STORE CREATION & STORAGE
# ============================================================
SELF_SERVICE_AUTO_APPROVE=true
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Optional phpMyAdmin External URL (Displayed as safe link only; NEVER captures credentials)
PHPMYADMIN_EXTERNAL_URL=

# ============================================================
# AI WEBSITE ANALYZER (Optional - Safe deterministic fallback if blank)
# Providers: openai | gemini | none
# ============================================================
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ============================================================
# OFFICIAL BKASH MERCHANT API (Optional - Sandbox / Production)
# ============================================================
BKASH_MODE=sandbox
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_WEBHOOK_SECRET=

# ============================================================
# SUPER ADMIN SEED ACCOUNT (Used only by scripts/seed-platform.ts)
# ============================================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeStrong!2026
